#!name = 携程每日签到
#!desc = 自动获取携程 Cookie 并执行每日定时签到（基于 NobyDa 脚本）
#!author = NobyDa
#!homepage = https://github.com/NobyDa/Script
#!icon = https://raw.githubusercontent.com/Orz-3/mini/master/Color/ctrip.png
#!date = 2026-11-14

[Script]
# 定时自动签到（默认每天早上 08:00 执行，可根据需要修改 Cron 表达式）
cron "0 8 * * *" script-path=https://raw.githubusercontent.com/NobyDa/Script/master/Ctrip-DailyBonus/Ctrip.js, timeout=60, tag=携程每日签到, enable=true

# 获取 Cookie（打开携程签到页面触发）
http-request ^https:\/\/m\.ctrip\.com\/restapi\/soa2\/14946\/json\/saveDailyBonus script-path=https://raw.githubusercontent.com/NobyDa/Script/master/Ctrip-DailyBonus/Ctrip.js, requires-body=false, timeout=60, tag=携程获取Cookie, enable=true

[MITM]
hostname = m.ctrip.com
