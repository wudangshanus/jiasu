[Script]
# 定时自动签到（每天早上 08:40 执行，双端签到并查询积分）
cron "40 8 * * *" script-path=https://raw.githubusercontent.com/Crazy-Z7/Task/main/Tuhyche.js, timeout=60, tag=途虎养车积分签到, enable=true
